				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run AppleScript.action</string>
				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionNameComment</key>
				<string>spindump, sample, syslog, defaults and allmemory</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}	do shell script "spindump Blotter -file " &amp; POSIX path of input &amp; "/spindump.Blotter.log" with administrator privileges	do shell script "allmemory -f -purge -64bit -proc `pgrep Blotter` -o " &amp; POSIX path of input &amp; "/allmemory.Blotter" with administrator privileges	do shell script "sample Blotter -file " &amp; POSIX path of input &amp; "/sample.Blotter.log"	do shell script "syslog -d store -F std -k Sender Blotter &gt; " &amp; POSIX path of input &amp; "/syslog.Blotter.log"	do shell script "defaults read net.wireload.blotter.mac &gt; " &amp; POSIX path of input &amp; "/net.wireload.blotter.plist"	do shell script "vmmap -v Blotter &gt; " &amp; POSIX path of input &amp; "/vmmap.Blotter.log"	return inputend run</string>
				</dict>
				<key>BundleIdentifier</key>
				<string>com.apple.Automator.RunScript</string>
				<key>CFBundleVersion</key>
				<string>1.0.2</string>
