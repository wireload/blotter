				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}	do shell script "spindump Blotter -file " &amp; POSIX path of input &amp; "/spindump.Blotter.log" with administrator privileges	do shell script "sample Blotter -file " &amp; POSIX path of input &amp; "/sample.Blotter.log"	return inputend run</string>
