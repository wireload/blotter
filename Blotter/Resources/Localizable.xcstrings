        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨겨진 경우 Finder에서 Blotter를 다시 열면 설정으로 돌아갈 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если значок скрыт, снова откройте Blotter в Finder, чтобы вернуться к настройкам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När den är dold öppnar du Blotter igen från Finder för att komma tillbaka till inställningarna."
          }
        }
      }
