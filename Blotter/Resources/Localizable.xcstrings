    "Approve Blotter in System Settings › General › Login Items.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Blotter unter Systemeinstellungen › Allgemein › Anmeldeobjekte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba Blotter en Ajustes del Sistema › General › Ítems de inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Blotter dans Réglages Système › Général › Ouverture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 › 一般 › ログイン項目でBlotterを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 일반 › 로그인 항목에서 Blotter를 승인하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Blotter в Системных настройках › Основные › Объекты входа."
