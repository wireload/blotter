    "When hidden, open Blotter again from Finder to get back to Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn es ausgeblendet ist, öffne Blotter erneut im Finder, um zu den Einstellungen zu gelangen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está oculto, vuelve a abrir Blotter desde el Finder para acceder a los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si elle est masquée, rouvrez Blotter depuis le Finder pour revenir aux réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示の場合は、FinderからBlotterをもう一度開くと設定に戻れます。"
