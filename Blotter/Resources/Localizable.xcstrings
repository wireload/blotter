    "Allow Blotter to access Reminders in System Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Blotter in den Systemeinstellungen den Zugriff auf Erinnerungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a Blotter acceder a Recordatorios en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Blotter à accéder à Rappels dans Réglages Système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でBlotterにリマインダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 Blotter가 미리 알림에 접근하도록 허용하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Blotter доступ к Напоминаниям в Системных настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge Blotter åtkomst till Påminnelser i Systeminställningar."
          }
        }
      }
    },
    "Allow Blotter to access your calendars in System Settings › Privacy & Security.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Blotter den Zugriff auf deine Kalender unter Systemeinstellungen › Datenschutz & Sicherheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite a Blotter acceder a tus calendarios en Ajustes del Sistema › Privacidad y seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Blotter à accéder à vos calendriers dans Réglages Système › Confidentialité et sécurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 › プライバシーとセキュリティで、Blotterにカレンダーへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 › 개인정보 보호 및 보안에서 Blotter가 캘린더에 접근하도록 허용하십시오."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Blotter доступ к календарям в Системных настройках › Конфиденциальность и безопасность."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge Blotter åtkomst till dina kalendrar i Systeminställningar › Integritet och säkerhet."
          }
        }
      }
    },
