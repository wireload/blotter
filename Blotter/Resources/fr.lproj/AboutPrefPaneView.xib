<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="5053" systemVersion="13C64" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <deployment version="1060" defaultVersion="1060" identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="5053"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="WLAboutPreferences">
            <connections>
                <outlet property="_bannerButton" destination="49" id="81"/>
                <outlet property="_copyrightView" destination="56" id="58"/>
                <outlet property="_versionView" destination="53" id="55"/>
                <outlet property="_wireloadButton" destination="47" id="80"/>
                <outlet property="view" destination="1" id="83"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application"/>
        <customView id="1">
            <rect key="frame" x="0.0" y="0.0" width="640" height="512"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
            <subviews>
                <imageView id="9" userLabel="Background Image View">
                    <rect key="frame" x="0.0" y="0.0" width="640" height="512"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <imageCell key="cell" refusesFirstResponder="YES" alignment="left" image="preferences-about-blotter-bg" id="10"/>
                </imageView>
                <imageView id="12" userLabel="Background Banner Image View">
                    <rect key="frame" x="0.0" y="0.0" width="640" height="512"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    <imageCell key="cell" refusesFirstResponder="YES" alignment="left" imageAlignment="bottom" image="preferences-about-blotter-banner-overlay" id="13"/>
                </imageView>
                <button id="23" userLabel="Follow us Button">
                    <rect key="frame" x="401" y="207" width="226" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="bevel" title="Suivez-nous sur Twitter" bezelStyle="regularSquare" image="preferences-about-blotter-twitter-icon" imagePosition="left" alignment="center" borderStyle="border" inset="2" id="24" customClass="WLPreferencesButtonCell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="showFollowUsOnTwitter:" target="-2" id="33"/>
                        <outlet property="nextKeyView" destination="1" id="79"/>
                    </connections>
                </button>
                <button id="25" userLabel="Get Support Button">
                    <rect key="frame" x="469" y="365" width="129" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="bevel" title="Obtenir de l'aide" bezelStyle="regularSquare" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="26" customClass="WLPreferencesButtonCell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="showGetSupport:" target="-2" id="32"/>
                        <outlet property="nextKeyView" destination="29" id="77"/>
                    </connections>
                </button>
                <button id="27" userLabel="Help Button">
                    <rect key="frame" x="401" y="365" width="53" height="22"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="bevel" title="Aide" bezelStyle="regularSquare" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="28" customClass="WLPreferencesButtonCell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="showHelp:" target="-2" id="31"/>
                        <outlet property="nextKeyView" destination="25" id="76"/>
                    </connections>
                </button>
                <button id="29" userLabel="Rate Button">
                    <rect key="frame" x="401" y="272" width="124" height="50"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="bevel" title="Évaluez cette app" bezelStyle="regularSquare" image="preferences-about-blotter-five-star-icon" imagePosition="above" alignment="center" borderStyle="border" inset="2" id="30" customClass="WLPreferencesButtonCell">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="showRateThisApp:" target="-2" id="34"/>
                        <outlet property="nextKeyView" destination="23" id="78"/>
                    </connections>
                </button>
                <button focusRingType="none" id="47" userLabel="Wireload Button" customClass="WLCustomCursorButton">
                    <rect key="frame" x="394" y="-1" width="246" height="88"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="square" bezelStyle="shadowlessSquare" imagePosition="overlaps" alignment="center" refusesFirstResponder="YES" state="on" focusRingType="none" transparent="YES" imageScaling="proportionallyDown" inset="2" id="48">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="showWireload:" target="-2" id="51"/>
                    </connections>
                </button>
                <button focusRingType="none" id="49" userLabel="Banner Button" customClass="WLCustomCursorButton">
                    <rect key="frame" x="0.0" y="-1" width="266" height="138"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <buttonCell key="cell" type="square" bezelStyle="shadowlessSquare" imagePosition="overlaps" alignment="center" refusesFirstResponder="YES" state="on" focusRingType="none" transparent="YES" imageScaling="proportionallyDown" inset="2" id="50">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="system"/>
                    </buttonCell>
                    <connections>
                        <action selector="showBanner:" target="-2" id="52"/>
                    </connections>
                </button>
                <textField verticalHuggingPriority="750" id="53" userLabel="Version Label">
                    <rect key="frame" x="562" y="428" width="81" height="25"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" refusesFirstResponder="YES" sendsActionOnEndEditing="YES" alignment="left" title="2.2" id="54">
                        <font key="font" size="20" name="HelveticaNeue-Bold"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <textField verticalHuggingPriority="750" horizontalCompressionResistancePriority="250" id="56">
                    <rect key="frame" x="400" y="126" width="199" height="39"/>
