<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="14113" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="14113"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSApplication">
            <connections>
                <outlet property="delegate" destination="494" id="495"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="494" customClass="DeskboardAppDelegate">
            <connections>
                <outlet property="_bringToFrontMenuItem" destination="575" id="580"/>
                <outlet property="_newEventMenuItem" destination="537" id="551"/>
                <outlet property="_newTaskMenuItem" destination="536" id="552"/>
                <outlet property="_preferencesMenuItem" destination="129" id="584"/>
                <outlet property="_showCurrentWeekMenuItem" destination="559" id="565"/>
                <outlet property="_showNextWeekMenuItem" destination="558" id="564"/>
                <outlet property="_showPreviousWeekMenuItem" destination="560" id="566"/>
                <outlet property="_statusMenu" destination="57" id="550"/>
            </connections>
        </customObject>
        <userDefaultsController representsSharedInstance="YES" id="569"/>
        <menu title="Blotter" systemMenu="apple" id="57">
            <items>
                <menuItem title="Bring to Front" id="575">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="bringToFrontOrSendToBack:" target="494" id="581"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="538"/>
                <menuItem title="New Event" tag="1" id="537">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showNewEvent:" target="494" id="582"/>
                    </connections>
                </menuItem>
                <menuItem title="New Reminder" tag="2" id="536">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showNewReminder:" target="494" id="583"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="557"/>
                <menuItem title="Next Week" id="558">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showNextWeek:" target="494" id="561"/>
                    </connections>
                </menuItem>
                <menuItem title="Current Week" id="559">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showCurrentWeek:" target="494" id="562"/>
                    </connections>
                </menuItem>
                <menuItem title="Previous Week" id="560">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showPreviousWeek:" target="494" id="563"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="577"/>
                <menuItem title="Preferences…" tag="3" id="129">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showPreferences:" target="494" id="554"/>
                    </connections>
                </menuItem>
                <menuItem title="Rate This App..." id="567">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showRateThisApp:" target="494" id="574"/>
                        <binding destination="569" name="hidden" keyPath="values.ShowRateThisAppInMenu" id="573">
                            <dictionary key="options">
                                <integer key="NSNullPlaceholder" value="1"/>
                                <string key="NSValueTransformerName">NSNegateBoolean</string>
                            </dictionary>
                        </binding>
                    </connections>
                </menuItem>
                <menuItem title="About Blotter" id="548">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="showAbout:" target="494" id="556"/>
                    </connections>
                </menuItem>
                <menuItem isSeparatorItem="YES" id="143">
                    <modifierMask key="keyEquivalentModifierMask" command="YES"/>
                </menuItem>
                <menuItem title="Quit Blotter" tag="4" id="136">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <connections>
                        <action selector="terminate:" target="-3" id="449"/>
                    </connections>
                </menuItem>
            </items>
            <connections>
                <outlet property="delegate" destination="494" id="547"/>
            </connections>
        </menu>
        <menu title="Main Menu" systemMenu="main" id="609" userLabel="Main Menu">
            <items>
                <menuItem title="Blotter" id="615">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Blotter" systemMenu="apple" id="622">
                        <items>
                            <menuItem title="Quit Blotter" keyEquivalent="q" id="630">
                                <connections>
                                    <action selector="terminate:" target="-1" id="760"/>
                                </connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="File" id="613">
                    <modifierMask key="keyEquivalentModifierMask"/>
                </menuItem>
                <menuItem title="Edit" id="610">
                    <modifierMask key="keyEquivalentModifierMask"/>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
