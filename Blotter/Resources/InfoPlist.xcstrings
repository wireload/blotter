    "NSRemindersFullAccessUsageDescription": {
      "comment": "Blotter shows your reminders on the desktop and adds the reminders you create.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter zeigt deine Erinnerungen auf dem Schreibtisch an und fügt die Erinnerungen hinzu, die du erstellst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter muestra tus recordatorios en el escritorio y añade los recordatorios que creas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter affiche vos rappels sur le bureau et ajoute ceux que vous créez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotterはデスクトップにリマインダーを表示し、作成したリマインダーを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter는 데스크탑에 미리 알림을 표시하고 사용자가 만든 미리 알림을 추가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter показывает ваши напоминания на рабочем столе и добавляет созданные вами напоминания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter visar dina påminnelser på skrivbordet och lägger till påminnelserna du skapar."
          }
        }
      }
    },
