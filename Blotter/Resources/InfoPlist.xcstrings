{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Blotter shows your events on the desktop and adds the events you create.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter zeigt deine Ereignisse auf dem Schreibtisch an und fügt die Ereignisse hinzu, die du erstellst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter muestra tus eventos en el escritorio y añade los eventos que creas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter affiche vos événements sur le bureau et ajoute ceux que vous créez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotterはデスクトップにイベントを表示し、作成したイベントを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter는 데스크탑에 이벤트를 표시하고 사용자가 만든 이벤트를 추가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter показывает ваши события на рабочем столе и добавляет созданные вами события."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Blotter visar dina aktiviteter på skrivbordet och lägger till aktiviteterna du skapar."
          }
        }
      }
    },
