<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="14313.18" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="14313.18"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="WLPositioningPreferences">
            <connections>
                <outlet property="_arrangement" destination="139" id="142"/>
                <outlet property="_screensController" destination="46" id="137"/>
                <outlet property="view" destination="1" id="150"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customView id="1" userLabel="Position View" customClass="WLPositioningPaneView">
            <rect key="frame" x="0.0" y="0.0" width="440" height="361"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <popUpButton verticalHuggingPriority="750" id="8">
                    <rect key="frame" x="159" y="317" width="141" height="26"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" title="狭い" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="11" id="9">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="menu"/>
                        <menu key="menu" title="OtherViews" id="10">
                            <items>
                                <menuItem title="狭い" state="on" id="11"/>
                                <menuItem title="普通" tag="1" id="12"/>
                                <menuItem title="フル" tag="2" id="13"/>
                                <menuItem title="カスタム" tag="3" id="133">
                                    <modifierMask key="keyEquivalentModifierMask"/>
                                </menuItem>
                            </items>
                        </menu>
                    </popUpButtonCell>
                    <connections>
                        <binding destination="25" name="selectedTag" keyPath="values.CalendarSize" id="134"/>
                        <outlet property="nextKeyView" destination="34" id="146"/>
                    </connections>
                </popUpButton>
                <textField verticalHuggingPriority="750" id="14">
                    <rect key="frame" x="18" y="323" width="137" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="right" title="カレンダーのサイズ：" id="15">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <outlet property="nextKeyView" destination="8" id="145"/>
                    </connections>
                </textField>
                <textField verticalHuggingPriority="750" id="34">
                    <rect key="frame" x="26" y="294" width="129" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="right" title="ディスプレイ：" id="35">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                    <connections>
                        <outlet property="nextKeyView" destination="64" id="147"/>
                    </connections>
                </textField>
                <popUpButton verticalHuggingPriority="750" id="64">
                    <rect key="frame" x="159" y="288" width="264" height="26"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" id="65">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="menu"/>
                        <menu key="menu" title="OtherViews" id="66"/>
                    </popUpButtonCell>
                    <connections>
                        <binding destination="46" name="content" keyPath="arrangedObjects" id="98"/>
                        <binding destination="46" name="enabled" keyPath="arrangedObjects" id="121">
                            <dictionary key="options">
                                <integer key="NSMultipleValuesPlaceholder" value="1"/>
                                <integer key="NSNullPlaceholder" value="0"/>
                                <string key="NSValueTransformerName">WLCountGreaterThanOneTransformer</string>
                            </dictionary>
                        </binding>
                        <binding destination="46" name="contentObjects" keyPath="arrangedObjects.ScreenIdentifier" previousBinding="98" id="122"/>
                        <binding destination="46" name="contentValues" keyPath="arrangedObjects.ScreenName" previousBinding="122" id="125"/>
                        <binding destination="25" name="selectedObject" keyPath="values.ScreenIdentifier" previousBinding="125" id="132"/>
                        <outlet property="nextKeyView" destination="139" id="148"/>
                    </connections>
                </popUpButton>
                <customView id="139" customClass="WLCalendarWindowArrangementView">
                    <rect key="frame" x="20" y="20" width="400" height="251"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <connections>
                        <outlet property="delegate" destination="-2" id="141"/>
                        <outlet property="nextKeyView" destination="1" id="149"/>
                    </connections>
                </customView>
            </subviews>
            <connections>
                <outlet property="_calendarWindowArrangementView" destination="139" id="143"/>
                <outlet property="nextKeyView" destination="14" id="144"/>
            </connections>
            <point key="canvasLocation" x="139" y="168.5"/>
        </customView>
        <userDefaultsController representsSharedInstance="YES" id="25"/>
        <arrayController objectClassName="NSScreen" editable="NO" preservesSelection="NO" selectsInsertedObjects="NO" avoidsEmptySelection="NO" id="46" customClass="WLScreensController">
            <declaredKeys>
                <string>WL_localizedScreenName</string>
                <string>deviceDescription.NSScreenNumber</string>
                <mutableString>ScreenIdentifier</mutableString>
                <string>count</string>
                <string>ScreenName</string>
