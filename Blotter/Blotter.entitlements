<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.scripting-targets</key>
	<dict>
		<key>com.apple.reminders</key>
		<array>
			<string>com.apple.Reminders.List.read-write</string>
			<string>com.apple.Reminders.read-write</string>
		</array>
		<key>com.apple.iCal</key>
		<array>
			<string>com.apple.iCal.read-write</string>
		</array>
		<key>com.apple.systempreferences</key>
		<array>
			<string>preferencepane.reveal</string>
		</array>
	</dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.temporary-exception.apple-events:before:10.8</key>
	<array>
		<string>com.apple.ical</string>
	</array>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
